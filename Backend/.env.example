PORT=3000
# Local/dev baseline only. Replace these credentials for shared or internet-exposed deployments.
DATABASE_URL=postgres://venda_user:venda_pass_2026@localhost:5432/venda
# Required: replace before starting the API.
# Both startup validation and docker compose reject the placeholder below.
# Example generator: openssl rand -base64 48 | tr -d '\n'
JWT_SECRET=replace_with_a_long_random_secret
# Optional. Comma-separated browser origins allowed to call the API.
# Leave blank to block cross-origin browser requests by default, except localhost origins outside production.
# Example: https://admin.example.com,https://pos.example.com
CORS_ALLOWED_ORIGINS=
# Optional. Defaults to true outside production and false in production.
# When enabled, http(s)://localhost, http(s)://127.0.0.1, and http(s)://[::1] are allowed automatically.
CORS_ALLOW_DEV_ORIGINS=
# Optional. Defaults to true so native apps and server-to-server clients without an Origin header keep working.
CORS_ALLOW_NO_ORIGIN=
